# name: test/sql/cache.test
# description: geocoding's vgi.cache.* result-cache advertisement (live Open-Meteo API)
# group: [vgi_open_meteo]

require-env VGI_OPEN_METEO_WORKER

# Transport failures must fail the suite rather than silently skip it.
set ignore_error_messages

statement ok
LOAD vgi;

statement ok
LOAD httpfs;

statement ok
ATTACH 'open_meteo' AS open_meteo (TYPE vgi, LOCATION '${VGI_OPEN_METEO_WORKER}');

statement ok
CREATE TABLE cities(city VARCHAR);

statement ok
INSERT INTO cities VALUES ('Berlin'), ('Paris'), ('Tokyo');

# ============================================================================
# Per-value memoization
#
# geocoding advertises `vgi.cache.per_value`, which is only meaningful for an
# exchange-mode MAP — so this must be a correlated LATERAL, not a literal call.
# The first pass populates the memo; the second should serve every value from it
# without reaching the worker (and therefore without an Open-Meteo request).
# ============================================================================

statement ok
SELECT count(*) FROM cities c, LATERAL open_meteo.main.geocoding(c.city, count := 1) g;

statement ok
CREATE TABLE primed AS SELECT exchange_hits AS hits, exchange_stores AS stores FROM vgi_result_cache_stats();

# The worker opted in, so the first pass must have stored per-value entries.
query I
SELECT stores > 0 FROM primed;
----
true

statement ok
SELECT count(*) FROM cities c, LATERAL open_meteo.main.geocoding(c.city, count := 1) g;

query I
SELECT (SELECT exchange_hits FROM vgi_result_cache_stats()) > (SELECT hits FROM primed);
----
true

# A memo serve must return the same answer as the upstream call, not an empty or
# truncated one.
query TII
SELECT g.name, round(g.latitude, 2), round(g.longitude, 2)
FROM cities c, LATERAL open_meteo.main.geocoding(c.city, count := 1) g
WHERE c.city = 'Berlin';
----
Berlin	52.52	13.41

# ============================================================================
# The memo key folds in the bind arguments
#
# `count` is a bind-time named arg, not part of the per-value input tuple, so it
# only stays correct because the extension folds canonical_arguments into the
# static key. If it did not, the primed count := 1 memo above would serve this
# call and return 1 row instead of 5.
# ============================================================================

query I
SELECT count(*) FROM cities c, LATERAL open_meteo.main.geocoding(c.city, count := 5) g
WHERE c.city = 'Berlin';
----
5

# ============================================================================
# elevation
#
# Terrain elevation is a pure function of (latitude, longitude) over a fixed
# DEM, so it advertises the longest window in the worker. Its call shape is not
# geocoding's: 1->1 rather than 1->N, and ELEVATION_BATCH already folds 100
# input rows into one upstream request — so the memo is asserted on repeat
# queries, which is where it actually pays, rather than on within-batch dedup.
# ============================================================================

statement ok
CREATE TABLE coords(lat DOUBLE, lon DOUBLE);

statement ok
INSERT INTO coords VALUES (52.52, 13.41), (27.99, 86.93), (35.68, 139.69);

statement ok
SELECT count(*) FROM coords c, LATERAL open_meteo.main.elevation(c.lat, c.lon) e;

statement ok
CREATE TABLE elev_primed AS SELECT exchange_hits AS hits, exchange_stores AS stores FROM vgi_result_cache_stats();

query I
SELECT stores > (SELECT stores FROM primed) FROM elev_primed;
----
true

statement ok
SELECT count(*) FROM coords c, LATERAL open_meteo.main.elevation(c.lat, c.lon) e;

query I
SELECT (SELECT exchange_hits FROM vgi_result_cache_stats()) > (SELECT hits FROM elev_primed);
----
true

# A memoized elevation must still be the real one, and must still land on the
# right outer row — elevation is the function lateral.test uses to pin
# provenance, and a per-value serve reassembles that mapping from the memo.
query IRI
SELECT round(c.lat, 2), round(e.latitude, 2), e.elevation > 8000
FROM coords c, LATERAL open_meteo.main.elevation(c.lat, c.lon) e
WHERE c.lat = 27.99;
----
27.99	27.99	true

# ============================================================================
# Per-value entries are stored per call (input_rows_per_call)
#
# geocoding declares input_rows_per_call = 8 and elevation 100 (its upstream
# batch), and neither continues its output — the extension stores no per-value
# entries for a call whose output continued. So a chunk split into several
# calls still memoizes every value, and a repeat is served without a single
# worker call.
# ============================================================================

statement ok
SET threads = 1;

statement ok
CREATE TABLE many_cities AS SELECT * FROM (VALUES
  ('Amsterdam'), ('Madrid'), ('Rome'), ('Vienna'), ('Prague'),
  ('Lisbon'), ('Dublin'), ('Oslo'), ('Helsinki'), ('Warsaw')) AS t(city);

statement ok
CALL enable_logging(level := 'debug');

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE TABLE before_many AS SELECT exchange_stores AS stores FROM vgi_result_cache_stats();

query I
SELECT count(DISTINCT c.city) FROM many_cities c, LATERAL open_meteo.main.geocoding(c.city, count := 1) g;
----
10

# Ten names went out as calls of 8 and 2.
query II
SELECT count(*), max(CAST(regexp_extract(message, 'input_rows=([0-9]+)', 1) AS BIGINT))
FROM duckdb_logs()
WHERE type = 'VGI'
  AND regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'table_in_out.write_input'
  AND message LIKE '%geocoding%';
----
2	8

query I
SELECT (SELECT exchange_stores FROM vgi_result_cache_stats()) - (SELECT stores FROM before_many) >= 10;
----
true

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(DISTINCT c.city) FROM many_cities c, LATERAL open_meteo.main.geocoding(c.city, count := 1) g;
----
10

# Every value from the memo: no worker call at all.
query I
SELECT count(*)
FROM duckdb_logs()
WHERE type = 'VGI'
  AND regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'table_in_out.write_input'
  AND message LIKE '%geocoding%';
----
0

# elevation: 101 distinct points = calls of 100 and 1, one upstream request each.
# (Kept just over one call: Open-Meteo counts every coordinate against the tier.)
statement ok
CREATE TABLE pts AS SELECT x, 40.0 + (x // 25) * 0.1 AS lat, -5.0 + (x % 25) * 0.1 AS lon FROM range(101) t(x);

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM pts p, LATERAL open_meteo.main.elevation(p.lat, p.lon) e WHERE e.latitude = p.lat AND e.longitude = p.lon;
----
101

query II
SELECT count(*), max(CAST(regexp_extract(message, 'input_rows=([0-9]+)', 1) AS BIGINT))
FROM duckdb_logs()
WHERE type = 'VGI'
  AND regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'table_in_out.write_input'
  AND message LIKE '%elevation%';
----
2	100

statement ok
CALL truncate_duckdb_logs();

query I
SELECT count(*) FROM pts p, LATERAL open_meteo.main.elevation(p.lat, p.lon) e WHERE e.latitude = p.lat AND e.longitude = p.lon;
----
101

query I
SELECT count(*)
FROM duckdb_logs()
WHERE type = 'VGI'
  AND regexp_extract(message, '''event'': ([a-z_.]+)', 1) = 'table_in_out.write_input'
  AND message LIKE '%elevation%';
----
0

statement ok
CALL disable_logging();

statement ok
RESET threads;
