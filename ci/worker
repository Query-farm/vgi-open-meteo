#!/usr/bin/env bash
# The worker as one executable, for ci/run-integration.sh and DuckDB's launch: LOCATION.
#   (no arguments)        stdio worker (src/bin/worker.ts)
#   --unix PATH           AF_UNIX socket (what `launch:` passes; handled by the SDK)
#   --http [--port N]     HTTP server (src/bin/serve.ts), printing PORT:<n> once listening
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
if [ "${1:-}" = "--http" ]; then
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) export VGI_HTTP_PORT="$2"; shift 2 ;;
      --port=*) export VGI_HTTP_PORT="${1#--port=}"; shift ;;
      --host) export VGI_HTTP_HOST="$2"; shift 2 ;;
      --host=*) export VGI_HTTP_HOST="${1#--host=}"; shift ;;
      *) echo "ci/worker: unknown HTTP option $1" >&2; exit 2 ;;
    esac
  done
  export VGI_HTTP_HOST="${VGI_HTTP_HOST:-127.0.0.1}"
  # A fixed key keeps state tokens valid across requests within a run.
  export VGI_SIGNING_KEY="${VGI_SIGNING_KEY:-dev}"
  exec bun run "$here/../src/bin/serve.ts"
fi
exec bun run "$here/../src/bin/worker.ts" "$@"
